uniform sampler2D SCREEN_TEXTURE;

const highp float darken_strength = 0.0; // Darkness level 0.0 to 1.0
const highp float blur_radius = 0.0; // Blur radius from 0.0 to 10.0

void fragment() {
    highp vec4 color = texture(SCREEN_TEXTURE, UV);

    //Darkness apply
    color.rgb *= (1.0 - darken_strength);

    //Blur apply
    highp vec4 blurred_color = vec4(0.0);
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            blurred_color += texture(SCREEN_TEXTURE, UV + vec2(x, y) * blur_radius / SCREEN_PIXEL_SIZE);
        }
    }
    blurred_color /= 9.0;

    COLOR = mix(color, blurred_color, 1.0);
}
