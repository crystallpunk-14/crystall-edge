<PanelContainer xmlns="https://spacestation14.io"
                xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                Margin="5 5 5 5">
    <PanelContainer.PanelOverride>
        <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#777777"/>
    </PanelContainer.PanelOverride>

    <BoxContainer Orientation="Vertical">
        <PanelContainer Name="HeaderPanel" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="6 3 6 3">
                <RichTextLabel Name="AspectName"/>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" Margin="10 10 10 4">
            <TextureRect Name="AspectIcon" SetSize="64 64" Stretch="KeepAspectCentered"/>
        </BoxContainer>

        <BoxContainer Name="DescriptionContainer" Orientation="Vertical" Margin="10 4 10 4">
            <RichTextLabel Name="AspectDescription" HorizontalAlignment="Center"/>
        </BoxContainer>

        <BoxContainer Name="RecipeContainer" Orientation="Vertical" HorizontalAlignment="Center" Margin="10 4 10 8"/>
    </BoxContainer>
</PanelContainer>
