dnd-character-creation-tab = Abilities
dnd-character-creation-abilities-header = Ability Scores
dnd-character-creation-abilities-intro = Assign your abilities with Point Buy or the Standard Array. Dice are not used. The modifier is floor((score − 10) / 2), and division rounds down.
dnd-ability-method-point-buy = Point Buy
dnd-ability-method-standard-array = Standard Array
dnd-ability-point-buy-hint = You have 27 points. Scores run from 8 to 15. A 14 costs 7, and a 15 costs 9.
dnd-ability-point-buy-budget = { $remaining } points left of { $budget }
dnd-ability-point-buy-cost = Costs { $cost }
dnd-ability-standard-array-hint = Assign 15, 14, 13, 12, 10, and 8. Each score is used once.
dnd-ability-score-line = Score { $score } · Modifier { $modifier } · { $band }
dnd-ability-proficiency = Proficiency Bonus { $bonus }
dnd-ability-proficiency-hint = Level { $level }. Added to attack rolls with weapons you are proficient with, and to spell attacks.
dnd-ability-armor-class = Armor Class { $ac }
dnd-ability-armor-class-hint = Base AC is 10 + your Dexterity modifier ({ $modifier }). Only one base calculation can be in effect. Armor and other features change it later.
dnd-ability-armor-class-unarmored-hint = With no armor on, AC is 10 + Dexterity ({ $dexterity }) + Constitution ({ $constitution }). A shield does not turn this off.
