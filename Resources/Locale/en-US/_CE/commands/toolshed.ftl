command-description-skill-add =
    Adds a skill to the piped entities, ignoring skill conditions.
command-description-skill-remove =
    Removes a skill from the piped entities.
command-description-achievement-add =
    Adds an achievement to the piped players. Written to the database in the background.
command-description-achievement-remove =
    Removes an achievement from the piped players. Written to the database in the background.
