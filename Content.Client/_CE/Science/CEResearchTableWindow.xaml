<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:science="clr-namespace:Content.Client._CE.Science"
               Title="{Loc 'ce-research-table-ui-title'}"
               SetSize="700 500"
               MinSize="700 300">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
        <science:CEScienceKnowledgeControl Name="KnowledgeControl"
                                            MinWidth="220"
                                            VerticalExpand="True"
                                            Margin="0 0 6 0" />
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <Label Name="NoPaperLabel"
                   Text="{Loc 'ce-research-table-ui-no-paper'}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   HorizontalExpand="True"
                   VerticalExpand="True" />
            <BoxContainer Name="ActiveContainer"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Visible="False" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
