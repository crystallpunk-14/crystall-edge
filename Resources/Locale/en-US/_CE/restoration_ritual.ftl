ce-restoration-ritual-sphere-whole = The Lucson Sphere is still whole - the ritual is not needed yet.
ce-restoration-ritual-unavailable = The Restoration Ritual cannot be performed now.
ce-restoration-ritual-missing-shards = Lightheart shards missing from the ritual pedestals: { $shards }.

ce-ritual-pedestal-slot-name = Lightheart shard
ce-ritual-pedestal-shard-rejected = This shard doesn't fit.

ce-ritual-pedestal-accepted-wrap = [font size=14][bold]{ $title }[/font][font size=12]
    { $message }[/bold][/font]
ce-ritual-pedestal-accepted-title = The { $count ->
    [1] first
    [2] second
    [3] third
    [4] fourth
    [5] fifth
    [6] sixth
   *[other] next
} crystal has been placed into a pedestal of the Lucson Sphere.
ce-ritual-pedestal-accepted-desc = { $remaining ->
    [0] Everything is ready for the ritual.
    [one] { $remaining } crystal left before the ritual.
   *[other] { $remaining } crystals left before the ritual.
}
