<ce:CEAchievementsWindow
    xmlns="https://spacestation14.io"
    xmlns:ce="clr-namespace:Content.Client._CE.Achievements.UI"
    Title="{Loc 'ce-achievements-window-title'}"
    MinSize="500 600">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer Name="SummaryPanel" StyleClasses="BackgroundPanel" Margin="4 4 4 0" Visible="False">
            <BoxContainer Orientation="Vertical" Margin="8 5">
                <Label Name="SummaryLabel" StyleClasses="LabelHeading" />
                <ProgressBar Name="SummaryBar" MinValue="0" MaxValue="1" HorizontalExpand="True" SetHeight="20" Margin="0 5 0 0">
                    <Label Name="SummaryPercentLabel" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ProgressBar>
            </BoxContainer>
        </PanelContainer>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="4">
            <BoxContainer Orientation="Vertical" Name="AchievementsList" SeparationOverride="4" />
        </ScrollContainer>
    </BoxContainer>
</ce:CEAchievementsWindow>
