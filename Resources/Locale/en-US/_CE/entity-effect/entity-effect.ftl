ce-entity-effect-guidebook-none = This effect has no description.

ce-entity-effect-guidebook-learn-skill = Teaches [color=#1fa383]{ $name }[/color].

ce-entity-effect-guidebook-add-z-velocity = Launches the target into the air with [color=#1fa383]{ $speed }[/color] force
ce-entity-effect-guidebook-apply-status = Applies the [color=#1fa383]{ $status }[/color] status effect for [color=#1fa383]{ $duration }[/color] sec.
ce-entity-effect-guidebook-apply-status-permanent = Applies the [color=#1fa383]{ $status }[/color] status effect until it is removed.
ce-entity-effect-guidebook-apply-animation-status = Applies the [color=#1fa383]{ $status }[/color] status effect until the end of the animation.
ce-entity-effect-guidebook-remove-status =Removes the [color=#1fa383]{ $status }[/color] status effect
ce-entity-effect-guidebook-dash = Dashes forward [color=#1fa383]{ $distance }[/color] m.
ce-entity-effect-guidebook-delete = Destroys the target
ce-entity-effect-guidebook-play-sound = Plays a sound
ce-entity-effect-guidebook-play-far-sound = Plays a sound audible from a distance
ce-entity-effect-guidebook-flash = Flashes and stuns the target
ce-entity-effect-guidebook-set-timed-appearance = Temporarily changes the entity's appearance
ce-entity-effect-guidebook-cosmetic-animation = Plays a visual animation
ce-entity-effect-guidebook-say-chat = Says: [color=#1fa383]"{ $sentence }"[/color]
ce-entity-effect-guidebook-shockwave-vfx = Creates a visual shockwave effect
ce-entity-effect-guidebook-weapon-effect-slot = Triggers the weapon's linked effects
ce-entity-effect-guidebook-weapon-arc-attack = Strikes in a [color=#1fa383]{ $arcWidth }°[/color] arc, hitting all targets caught within it
ce-entity-effect-guidebook-damage = Deals { $damages } damage
ce-entity-effect-guidebook-damage-entry = [color=#1fa383]{ $amount }[/color] { $type }
ce-entity-effect-guidebook-heal = Heals { $heals }
ce-entity-effect-guidebook-heal-entry = [color=#1fa383]{ $amount }[/color] { $group }
ce-entity-effect-guidebook-modify-bleeding-reduce = Reduces bleeding by [color=#1fa383]{ $amount }[/color]
ce-entity-effect-guidebook-modify-bleeding-increase = Increases bleeding by [color=#1fa383]{ $amount }[/color]
ce-entity-effect-guidebook-modify-blood-level-restore = Restores [color=#1fa383]{ $amount }[/color]u of blood
ce-entity-effect-guidebook-modify-blood-level-drain = Drains [color=#1fa383]{ $amount }[/color]u of blood
ce-entity-effect-guidebook-shoot-projectile = Fires [color=#1fa383]{ $count }[/color]x [color=#1fa383]{ $item }[/color]
ce-entity-effect-guidebook-vomit = Has a [color=#1fa383]{ $chance }%[/color] chance of making the target vomit
ce-entity-effect-guidebook-irradiate = Irradiates the area with [color=#1fa383]{ $charge }[/color] magical energy for [color=#1fa383]{ $duration }[/color] sec.
ce-entity-effect-guidebook-change-mana-restore = Restores [color=#1fa383]{ $amount }[/color] mana
ce-entity-effect-guidebook-change-mana-drain = Drains [color=#1fa383]{ $amount }[/color] mana
ce-entity-effect-guidebook-spawn-entity = Spawns [color=#1fa383]{ $entities }[/color]
ce-entity-effect-guidebook-spawn-in-hand = Spawns [color=#1fa383]{ $entities }[/color] into the target's hand
ce-entity-effect-guidebook-eject-slot-item = Ejects an item from the slot
ce-entity-effect-guidebook-throw-from = Throws the target away with [color=#1fa383]{ $power }[/color] force
ce-entity-effect-guidebook-throw-to = Throws the target with [color=#1fa383]{ $power }[/color] force
ce-entity-effect-guidebook-use-item = Uses the item on the target, as if clicked with it
ce-entity-effect-guidebook-stamina-damage = Deals [color=#1fa383]{ $amount }[/color] stamina damage
ce-entity-effect-guidebook-stamina-restore = Restores [color=#1fa383]{ $amount }[/color] stamina
ce-entity-effect-guidebook-drop-held-items = Makes the target drop what it holds in its hands
ce-entity-effect-guidebook-affect-plant-energy = Gives a plant [color=#1fa383]{ $amount }[/color] energy
ce-entity-effect-guidebook-affect-plant-resource = Gives a plant [color=#1fa383]{ $amount }[/color] resource
ce-entity-effect-guidebook-affect-plant-growth = Gives a plant [color=#1fa383]{ $amount }[/color] growth

ce-entity-effect-guidebook-area-effect =
    Applies the following effects to everything within a [color=#1fa383]{ $range }[/color] radius:
    { $effects }
ce-entity-effect-guidebook-conditional-effect-group =
    If the conditions are met:
    { $effects }

ce-revivable-required = Only a dead body whose soul has not left it for good can be brought back.

ce-in-secret-department-required = The target must belong to: { $department }.
ce-in-secret-department-forbidden = The target must not belong to: { $department }.

ce-mob-state-required = The target must be { $state }.
ce-mob-state-forbidden = The target must not be { $state }.
ce-mob-state-alive = alive
ce-mob-state-critical = in critical condition
ce-mob-state-dead = dead
ce-mob-state-invalid = in an invalid state

ce-in-murk-required = The target must be in the murk.
ce-in-murk-forbidden = The target must be within the light of the Lucson Sphere.

ce-modify-bleeding-stopped = The bleeding has stopped.
ce-entity-effect-guidebook-knockdown = Knocks down for [color=#1fa383]{ $amount }[/color] sec.
ce-entity-effect-guidebook-modify-stealth-visibility = Changes the visibility of a cloaked target by [color=#1fa383]{ $amount }[/color]
ce-entity-effect-guidebook-murk-dissolve = Dissolves [color=#1fa383]{ $amount }[/color] of murk
