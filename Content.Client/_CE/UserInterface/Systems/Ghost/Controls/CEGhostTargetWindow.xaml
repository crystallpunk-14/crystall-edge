<controls:CEGhostTargetWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client._CE.UserInterface.Systems.Ghost.Controls"
               xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
               Title="{Loc 'ghost-target-window-title'}" MinSize="620 500"
               SetSize="680 560">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="0 4 0 4">
            <RichTextLabel Text="{Loc 'ghost-target-window-warp-to-title'}" HorizontalAlignment="Center" />
            <PanelContainer StyleClasses="LowDivider" Margin="0 5" />
            <BoxContainer Orientation="Horizontal" Align="Center">
                <Button Name="GhostnadoButton" Text="{Loc 'ghost-target-window-warp-to-most-followed'}"
                        ToolTip="{Loc 'ghost-target-window-warp-to-most-followed-tooltip'}"
                        HorizontalAlignment="Center" StyleClasses="OpenRight" />
                <Button Name="WarpToRandomFollowedButton" Text="{Loc 'ghost-target-window-warp-to-random-followed'}"
                        ToolTip="{Loc 'ghost-target-window-warp-to-random-followed-tooltip'}"
                        HorizontalAlignment="Center" StyleClasses="OpenBoth" />
                <Button Name="WarpToRandomButton" Text="{Loc 'ghost-target-window-warp-to-random'}"
                        ToolTip="{Loc 'ghost-target-window-warp-to-random-tooltip'}" HorizontalAlignment="Center"
                        StyleClasses="OpenLeft" />
            </BoxContainer>
        </BoxContainer>
        <LineEdit Name="SearchBar" PlaceHolder="{Loc 'window-search-bar-placeholder'}" HorizontalExpand="True" Margin="0 4" />
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" VerticalExpand="True" SeparationOverride="10">

                <BoxContainer Name="PlayersSection" Orientation="Vertical">
                    <RichTextLabel Text="{Loc 'ce-ghost-target-window-players-title'}" HorizontalAlignment="Center" />
                    <PanelContainer Name="PlayersHeaderPanel">
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4" Margin="4 2 4 2">
                            <Label Name="PlayersNameHeader" SizeFlagsStretchRatio="3" HorizontalExpand="True"
                                   ClipText="True" MouseFilter="Pass" />
                            <cc:VSeparator />
                            <Label Name="PlayersJobHeader" SizeFlagsStretchRatio="2" HorizontalExpand="True"
                                   ClipText="True" MouseFilter="Pass" />
                            <cc:VSeparator />
                            <Label Name="PlayersSecretRoleHeader" SizeFlagsStretchRatio="2" HorizontalExpand="True"
                                   ClipText="True" MouseFilter="Pass" />
                            <cc:VSeparator />
                            <Control MinSize="64 0" />
                        </BoxContainer>
                    </PanelContainer>
                    <BoxContainer Name="PlayersRows" Orientation="Vertical" />
                </BoxContainer>

                <BoxContainer Name="LocationsSection" Orientation="Vertical">
                    <RichTextLabel Text="{Loc 'ce-ghost-target-window-locations-title'}" HorizontalAlignment="Center" />
                    <PanelContainer Name="LocationsHeaderPanel">
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4" Margin="4 2 4 2">
                            <Label Name="LocationsNameHeader" HorizontalExpand="True" ClipText="True" MouseFilter="Pass" />
                            <Control MinSize="32 0" />
                        </BoxContainer>
                    </PanelContainer>
                    <BoxContainer Name="LocationsRows" Orientation="Vertical" />
                </BoxContainer>

            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</controls:CEGhostTargetWindow>
