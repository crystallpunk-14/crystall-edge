<controls:CEGhostWarpPlayerRow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client._CE.UserInterface.Systems.Ghost.Controls"
               xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4" Margin="4 2 4 2">
        <Label Name="NameLabel" SizeFlagsStretchRatio="3" HorizontalExpand="True" ClipText="True" />
        <cc:VSeparator />
        <BoxContainer Name="JobCell" Orientation="Horizontal" SizeFlagsStretchRatio="2" HorizontalExpand="True" MouseFilter="Stop">
            <TextureRect Name="JobIcon" Stretch="KeepAspectCentered" SetSize="20 20" Margin="0 0 4 0" Visible="False" />
            <Label Name="JobLabel" HorizontalExpand="True" ClipText="True" />
        </BoxContainer>
        <cc:VSeparator />
        <BoxContainer Name="SecretRoleCell" Orientation="Horizontal" SizeFlagsStretchRatio="2" HorizontalExpand="True" MouseFilter="Stop">
            <TextureRect Name="SecretRoleIcon" Stretch="KeepAspectCentered" SetSize="20 20" Margin="0 0 4 0" Visible="False" />
            <Label Name="SecretRoleLabel" HorizontalExpand="True" ClipText="True" />
        </BoxContainer>
        <cc:VSeparator />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" MinSize="64 0" SeparationOverride="4">
            <!-- Same icon as the game's own top-menu "Character" button - character.svg is 48x63
                 native vs right_arrow's 24x28, scaled down so both icons render at a comparable size -->
            <TextureButton Name="InfoButton" Access="Public" TexturePath="/Textures/Interface/character.svg.192dpi.png"
                           Scale="0.35 0.35" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- point.svg (the "Point At" verb icon) is 64x64 native - a solid directional
                 arrow, reads better as "travel there" than the thin right_arrow chevron did -->
            <TextureButton Name="WarpButton" Access="Public" TexturePath="/Textures/Interface/VerbIcons/point.svg.192dpi.png"
                           Scale="0.34 0.34" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </BoxContainer>
    </BoxContainer>
</controls:CEGhostWarpPlayerRow>
