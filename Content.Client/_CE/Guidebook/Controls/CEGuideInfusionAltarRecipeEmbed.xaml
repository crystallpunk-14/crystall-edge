<PanelContainer xmlns="https://spacestation14.io"
                xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                Margin="5 5 5 5">
    <PanelContainer.PanelOverride>
        <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#777777"/>
    </PanelContainer.PanelOverride>

    <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="6">
            <EntityPrototypeView Name="ResultView"
                                  MinSize="48 48"
                                  MaxSize="48 48"
                                  Scale="2,2"
                                  HorizontalAlignment="Left" />
            <RichTextLabel Name="ResultName" VerticalAlignment="Center" />
        </BoxContainer>

        <BoxContainer Name="CatalystContainer" Orientation="Vertical" Margin="0 6 0 0" />

        <Label Text="{Loc 'ce-guidebook-infusion-altar-essences'}" Margin="0 6 0 0" />
        <BoxContainer Name="EssenceContainer" Orientation="Horizontal" SeparationOverride="12" />

        <BoxContainer Name="PedestalSection" Orientation="Vertical" Visible="False">
            <Label Text="{Loc 'ce-guidebook-infusion-altar-pedestals'}" Margin="0 6 0 0" />
            <BoxContainer Name="PedestalContainer" Orientation="Horizontal" SeparationOverride="6" />
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
