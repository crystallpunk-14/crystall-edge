<BoxContainer xmlns="https://spacestation14.io"
              Orientation="Vertical"
              Margin="0 0 0 6"
              HorizontalExpand="True">
    <PanelContainer Name="Background"
                    StyleClasses="PdaBackground"
                    MinHeight="15"
                    VerticalExpand="False"
                    HorizontalExpand="True"
                    Margin="0 0 0 -5"/>
    <BoxContainer Orientation="Vertical" Margin="5">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <TextureRect Name="IconTexture" TextureScale="2 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6 0 0 0">
                <Label Name="NameLabel" StyleClasses="LabelKeyText"/>
                <Label Name="RarityLabel" StyleClasses="LabelSubText"/>
            </BoxContainer>
        </BoxContainer>
        <Control MinHeight="5"/>
        <RichTextLabel Name="DescLabel" HorizontalExpand="True" StyleClasses="LabelSubText"/>
        <Control MinHeight="5"/>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
            <BoxContainer Name="CostContainer" Orientation="Horizontal" Margin="0 0 6 0"/>
            <Button Name="ChooseButton" Text="{Loc 'ce-research-card-choose-button'}"/>
        </BoxContainer>
    </BoxContainer>
</BoxContainer>
