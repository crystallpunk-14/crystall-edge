<science:CEResearchActionControl
    xmlns="https://spacestation14.io"
    xmlns:science="clr-namespace:Content.Client._CE.Science"
    Orientation="Vertical"
    Margin="0 0 0 4"
    HorizontalExpand="True">
    <Button Name="ExecuteButton" Access="Public" HorizontalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Name="NameLabel" Access="Public" HorizontalExpand="True" ClipText="True" />
            <TextureRect Name="CostIcon" Access="Public" VerticalAlignment="Center" />
            <Label Name="CostLabel" Access="Public" VerticalAlignment="Center" Margin="4 0 0 0" />
        </BoxContainer>
    </Button>
</science:CEResearchActionControl>
